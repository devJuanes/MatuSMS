# MatuSMS Dashboard — producción (matusms.matubyte.com)
# Copiar desde la raíz del repo:
#   cd apps && cp ../deploy/env/web.production.env.example web/.env
# IMPORTANTE: Vite embebe estas variables en el build. Tras cambiarlas, ejecutar:
#   pnpm --filter @matusms/web build

APP_NAME=MatuSMS
VITE_API_BASE_URL=https://api.sms.matubyte.com

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Agregar matusms.matubyte.com en Firebase Console → Authentication → Authorized domains
VITE_TURNSTILE_SITE_KEY=
