# MatuSMS API — producción (api.sms.matubyte.com)
# Copiar desde la raíz del repo:
#   cd apps && cp ../deploy/env/api.production.env.example api/.env

APP_NAME=MatuSMS
PORT=8000
NODE_ENV=production

# MatuDB
MATUDB_URL=https://db.matudb.com
MATUDB_PROJECT_ID=
MATUDB_API_KEY=
MATUDB_USE_SUPABASE=false

# Redis 7+ o Upstash (requerido para colas BullMQ en producción)
REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL=rediss://default:PASSWORD@your-upstash.upstash.io:6379

# Firebase Admin — ruta absoluta en el servidor
FIREBASE_SERVICE_ACCOUNT_PATH=/var/www/matusms/apps/api/service-account.json
# O inline (escapar comillas en JSON):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

SYSTEM_USER_ID=system-user-id
SYSTEM_USER_API_KEY=

# CORS — solo el dominio del dashboard
CORS_ORIGIN=https://matusms.matubyte.com

# URL pública usada en QR de la app Android
API_PUBLIC_URL=https://api.sms.matubyte.com

# SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=system@matusms.com

LEMONSQUEEZY_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
ATTACHMENTS_BUCKET=matusms-attachments
