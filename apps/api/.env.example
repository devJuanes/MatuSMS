# MatuSMS API
APP_NAME=MatuSMS
PORT=8000
NODE_ENV=development

# MatuDB
MATUDB_URL=https://db.matudb.com
MATUDB_PROJECT_ID=
MATUDB_API_KEY=
MATUDB_USE_SUPABASE=false

# Redis (local or Upstash)
REDIS_URL=redis://localhost:6379

# Firebase Admin (path to service account JSON or inline JSON)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# System user for internal jobs
SYSTEM_USER_ID=system-user-id
SYSTEM_USER_API_KEY=system-user-api-key

# CORS
CORS_ORIGIN=http://localhost:3000
# Producción: CORS_ORIGIN=https://matusms.matubyte.com

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEMONSQUEEZY_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
ATTACHMENTS_BUCKET=matusms-attachments

# Public API URL (used in Android link QR payloads)
API_PUBLIC_URL=https://api.matusms.com
# Producción: API_PUBLIC_URL=https://api.sms.matubyte.com
